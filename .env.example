# Скопіюйте цей файл у .env (cp .env.example .env) і підставте свої значення.
# Файл .env у Git НЕ потрапляє (див. .gitignore). Реальних секретів тут бути не має.

# Секретний ключ Django. Згенеруйте власний:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string

# True лише для локальної розробки. На сервері має бути False.
DEBUG=True

# Дозволені хости через кому.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origin-и фронтенду для CORS (через кому, без пробілів).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# Файл бази даних SQLite (відносно кореня проєкту).
DATABASE_NAME=db.sqlite3

# Терміни життя JWT токенів.
ACCESS_TOKEN_LIFETIME_MINUTES=5
REFRESH_TOKEN_LIFETIME_DAYS=1

# Рівень логування: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
